# ===== LLM 按角色分组配置（ARCHITECTURE.md §6，计划阶段 1）=====
# 未配置时对应 provider 自动降级 mock，不报错。key 只被程序读取，不打印不提交。
# 角色 chat（决策/对话/摘要，deepseek，OpenAI 兼容）
#   映射顺序：CHAT_API_KEY → DEEPSEEK_API_KEY（根 .env 实际命名）
CHAT_API_BASE=
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat
# 角色 vision（图像理解/人脸候选/场景标签，dashscope qwen-vl，OpenAI 兼容）
#   映射顺序：VISION_API_KEY → DASHSCOPE_API_KEY（根 .env 实际命名）
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus

# 环境文件：默认依次读 backend/.env 与仓库根 .env（已有环境变量优先）；
# 设置 ECHO_ENV_FILE 则只读指定文件。
ECHO_ENV_FILE=

# 旧版通用配置（get_llm_config 向后兼容保留）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=qwen3.7plus

# Blender 无头二进制路径（pipeline/blender_gen.py）
BLENDER_PATH=/root/meetmind_go/blender-4.5.12-linux-x64/blender

# 运行期数据目录（facts/ inferences/ people/ derived/ 的根），默认 backend/data
ECHO_DATA_DIR=

# K3 Context Hub -> EchoWorld 接收接口（/v1/physical-ai/*）。
# token 必须由部署环境注入；不要提交真实值。
PHYSICAL_AI_AGENT_TOKEN=
# 联调负责人提供 agent-package.schema.json 后配置绝对路径，启用完整 JSON Schema 校验。
PHYSICAL_AI_PACKAGE_SCHEMA=
